  "philosophy": {
    "title": {
      "en": "The Community Philosophy",
      "sv": "Communityts filosofi"
    },
    "intro": {
      "en": "Haunted Sweden is not about proving ghosts.",
      "sv": "Haunted Sweden handlar inte om att bevisa spöken."
    },
    "points": [
      {
        "en": "History",
        "sv": "Historia"
      },
      {
        "en": "Folklore",
        "sv": "Folklore"
      },
      {
        "en": "Mystery",
        "sv": "Mysterium"
      },
      {
        "en": "Critical thinking",
        "sv": "Kritiskt tänkande"
      },
      {
        "en": "Respect for historical facts",
        "sv": "Respekt för historiska fakta"
      }
    ],
    "closing": {
      "en": "We explore carefully. We document honestly. We never confuse local legend with verified history — and we avoid sensationalism.",
      "sv": "Vi utforskar noggrant. Vi dokumenterar ärligt. Vi blandar aldrig lokal legend med verifierad historia — och vi undviker sensationalism."
    }
  },
