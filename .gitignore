# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# admin security runtime data
/data/admin-security/*.json
/data/admin-security/*.log

# members runtime store (local JSON; Blob in production)
/data/members/*.json

# IndexNow (keep key.txt out of git — use INDEXNOW_KEY on Vercel)
/data/indexnow/key.txt
/data/indexnow/state.json
/data/indexnow/env.example.txt
/public/*.txt
!public/audio/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
